# The KubeVirt lab: a kind cluster that runs Cluster API, CAPK, KubeVirt, CDI and the chalkos
# providers, and a workload cluster of chalkos VMs on it. The VMs boot chalkos's released images
# from ghcr.io, and the providers are the release provider_version names, so nothing is built.
# From the devshell (nix develop), from any directory:
#
#   just -f lab/justfile up
#
# up runs create, kubevirt, providers and cluster in order. providers-local in place of providers
# builds the providers from the checkout, as the end-to-end test does:
#
#   just -f lab/justfile create kubevirt providers-local cluster
#
# Every recipe can run again. All state lives in .lab/ of the repository, never in /tmp.

set working-directory := ".."

export kind_name := "chalkos-lab"
export kubevirt_version := "v1.10.0"
export cdi_version := "v1.66.1"
# Cluster API core is the release go.mod builds the providers against, and clusterctl, a go.mod
# tool, is of the same release.
export capi_version := `go list -m sigs.k8s.io/cluster-api | cut -d" " -f2`
export capk_version := "v0.11.2"
# The latest release of the chalkos providers, which release-please sets with each release.
export provider_version := "v0.1.0" # x-release-please-version
# The chalkos release whose images the VMs boot: the one go.mod builds the providers against,
# which Renovate bumps with the flake input. The images are those of its Kubernetes minor,
# ghcr.io/trevex/chalkos/kubernetes-<minor>-kvm and its containerDisk, <...>-kvm-disk.
export chalkos_version := `go list -m github.com/trevex/chalkos | cut -d" " -f2`
export kubernetes_minor := "1.37"
export chalkos_image := "ghcr.io/trevex/chalkos/kubernetes-" + kubernetes_minor + "-kvm"
# The registry host in the names of the providers' images that providers-local builds. The images
# go straight into the kind node, so no registry serves them.
export local_registry := "kind.local"

lab := justfile_directory() / ".." / ".lab"

# The kind cluster's kubeconfig and the temporary files stay in .lab, off the tmpfs.
export KUBECONFIG := lab / "kind.kubeconfig"
export TMPDIR := lab / "tmp"

default:
    @just --list --justfile {{justfile()}}

[doc("Create the lab and its workload cluster from released images: create kubevirt providers cluster.")]
up: create kubevirt providers cluster

[doc("Create the kind cluster.")]
create:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{lab}}/tmp
    if ! kind get clusters | grep -qx "$kind_name"; then
      kind create cluster --name "$kind_name" --kubeconfig "$KUBECONFIG"
    fi
    for node in $(kind get nodes --name "$kind_name"); do
      # A VM on the pod network takes its pod's /24 as on-link, so it reaches other pods, among
      # them the providers and the other VMs, by ARP; the node answers for them.
      docker exec "$node" sysctl -q -w net.ipv4.conf.all.proxy_arp=1
    done

# Install KubeVirt and CDI, which imports the VMs' disks from ghcr.io.
kubevirt:
    #!/usr/bin/env bash
    set -euo pipefail
    kubectl apply --server-side --force-conflicts -f "https://github.com/kubevirt/kubevirt/releases/download/$kubevirt_version/kubevirt-operator.yaml"
    kubectl apply -f lab/manifests/kubevirt-cr.yaml
    if [ ! -e /dev/kvm ]; then
      kubectl -n kubevirt patch kubevirt kubevirt --type merge \
        -p '{"spec":{"configuration":{"developerConfiguration":{"useEmulation":true}}}}'
    fi
    kubectl apply --server-side --force-conflicts -f "https://github.com/kubevirt/containerized-data-importer/releases/download/$cdi_version/cdi-operator.yaml"
    kubectl apply -f lab/manifests/cdi-cr.yaml
    kubectl -n kubevirt wait kubevirt kubevirt --for condition=Available --timeout 15m
    kubectl wait cdi cdi --for condition=Available --timeout 15m

# clusterctl fetches the components of provider_version from the GitHub release, as
# lab/clusterctl.yaml names them. A lab whose providers run already keeps them, released or local.
[doc("Install the released chalkos providers with Cluster API, cert-manager and CAPK.")]
providers:
    #!/usr/bin/env bash
    set -euo pipefail
    if kubectl get namespace bootstrap-chalkos-system >/dev/null 2>&1; then
      echo "the chalkos providers run already; just destroy and create the lab again to change them"
      exit 0
    fi
    clusterctl init --config lab/clusterctl.yaml --wait-providers \
      --core "cluster-api:$capi_version" \
      --infrastructure "kubevirt:$capk_version" \
      --bootstrap "chalkos:$provider_version" --control-plane "chalkos:$provider_version"

# The images are tagged dev and loaded into the kind node, which runs them without a pull. A
# second run, or a run on a lab with the released providers, rolls the managers out to the images
# it built.
[doc("Build the chalkos providers from the checkout and install them, with Cluster API, cert-manager and CAPK.")]
providers-local:
    #!/usr/bin/env bash
    set -euo pipefail
    make local-repo-manifests REGISTRY="$local_registry" IMG_TAG=dev
    for p in bootstrap controlplane; do
      docker build --build-arg package=$p -t "$local_registry/cluster-api-provider-chalkos-$p:dev" .
      kind load docker-image --name "$kind_name" "$local_registry/cluster-api-provider-chalkos-$p:dev"
    done
    if kubectl get namespace bootstrap-chalkos-system >/dev/null 2>&1; then
      for p in bootstrap:bootstrap-chalkos controlplane:control-plane-chalkos; do
        deployment="deployment/${p#*:}-controller-manager"
        kubectl -n "${p#*:}-system" set image "$deployment" \
          "manager=$local_registry/cluster-api-provider-chalkos-${p%%:*}:dev"
        kubectl -n "${p#*:}-system" rollout restart "$deployment"
        kubectl -n "${p#*:}-system" rollout status "$deployment" --timeout 5m
      done
    else
      clusterctl init --config out/clusterctl.yaml --wait-providers \
        --core "cluster-api:$capi_version" \
        --infrastructure "kubevirt:$capk_version" \
        --bootstrap chalkos --control-plane chalkos
    fi

# The ChalkosControlPlane and the ChalkosConfigTemplate name the chalkos image by digest, the
# DataVolumes its containerDisk, and the version is the Kubernetes release the image carries.
[doc("Create the workload cluster lab from lab/cluster.yaml.tmpl and chalkos's released images.")]
cluster:
    #!/usr/bin/env bash
    set -euo pipefail
    image="$chalkos_image@$(crane digest "$chalkos_image:$chalkos_version")"
    disk="$chalkos_image-disk@$(crane digest "$chalkos_image-disk:$chalkos_version")"
    version=v$(crane manifest "$image" | jq -er '.annotations["dev.chalkos.kubernetes.version"]')
    echo "chalkos $chalkos_version with Kubernetes $version: $image"
    sed -e "s|@IMAGE@|$image|g" -e "s|@DISK@|$disk|g" -e "s|@VERSION@|$version|g" \
      lab/cluster.yaml.tmpl > {{lab}}/cluster.yaml
    # CAPK's webhook may refuse connections for a moment after clusterctl init returns.
    for attempt in $(seq 12); do
      kubectl apply -f {{lab}}/cluster.yaml && exit 0
      sleep 5
    done
    exit 1

# Show the workload cluster's state.
describe:
    clusterctl describe cluster lab --show-conditions all

# The host reaches the API server through the NodePort Service lab-api on the kind node; its
# certificate is still checked against the endpoint, lab-lb's ClusterIP.
[doc("Write the workload cluster's kubeconfig to .lab/lab.kubeconfig, reachable from the host.")]
kubeconfig:
    #!/usr/bin/env bash
    set -euo pipefail
    kubectl apply -f lab/manifests/lab-api.yaml >/dev/null
    port=$(kubectl get service lab-api -o jsonpath='{.spec.ports[0].nodePort}')
    node=$(docker inspect -f '{{{{.NetworkSettings.Networks.kind.IPAddress}}' "$kind_name-control-plane")
    clusterctl get kubeconfig lab > {{lab}}/lab.kubeconfig
    server=$(kubectl --kubeconfig {{lab}}/lab.kubeconfig config view -o jsonpath='{.clusters[0].cluster.server}')
    host=${server#https://}; host=${host%:*}
    cluster=$(kubectl --kubeconfig {{lab}}/lab.kubeconfig config view -o jsonpath='{.clusters[0].name}')
    kubectl --kubeconfig {{lab}}/lab.kubeconfig config set-cluster "$cluster" \
      --server "https://$node:$port" --tls-server-name "$host" >/dev/null
    # kube-proxy opens a new NodePort a moment after the Service exists.
    for attempt in $(seq 30); do
      kubectl --kubeconfig {{lab}}/lab.kubeconfig get --raw /readyz >/dev/null 2>&1 && exit 0
      sleep 1
    done
    echo "the API server does not answer at https://$node:$port" >&2
    exit 1

# Run kubectl against the workload cluster.
[positional-arguments]
kt *args:
    @[ -f {{lab}}/lab.kubeconfig ] || just --justfile {{justfile()}} kubeconfig
    @kubectl --kubeconfig {{lab}}/lab.kubeconfig "$@"

# Delete the workload cluster with the kind cluster.
destroy:
    -kind delete cluster --name "$kind_name" --kubeconfig "$KUBECONFIG"
    rm -rf {{lab}}/lab.kubeconfig {{lab}}/cluster.yaml
