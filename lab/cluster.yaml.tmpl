# The lab's workload cluster: one control plane and one worker, each a KubeVirt VM that boots the
# chalkos Kubernetes image from its own DataVolume and is installed in place over chalkd.
# The justfile's cluster recipe replaces @IMAGE@ with chalkos's released image by digest, @DISK@
# with its containerDisk by digest and @VERSION@ with the Kubernetes release the image carries.
# CDI, the providers and the nodes pull them from ghcr.io.
#
# The workload cluster's pod and service ranges stay clear of kind's, 10.244.0.0/16 and
# 10.96.0.0/16: the VMs' own addresses are kind pod addresses, and the API server's endpoint is a
# kind Service.
apiVersion: cluster.x-k8s.io/v1beta2
kind: Cluster
metadata:
  name: lab
  namespace: default
spec:
  clusterNetwork:
    pods:
      cidrBlocks: [10.192.0.0/16]
    services:
      cidrBlocks: [10.128.0.0/16]
  infrastructureRef:
    apiGroup: infrastructure.cluster.x-k8s.io
    kind: KubevirtCluster
    name: lab
  controlPlaneRef:
    apiGroup: controlplane.cluster.x-k8s.io
    kind: ChalkosControlPlane
    name: lab
---
# CAPK makes the Service lab-lb in front of the control planes' VMs; its ClusterIP is the API
# server's endpoint, which the providers and the VMs reach inside kind.
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
kind: KubevirtCluster
metadata:
  name: lab
  namespace: default
spec:
  controlPlaneServiceTemplate:
    spec:
      type: ClusterIP
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
kind: KubevirtMachineTemplate
metadata:
  name: lab-control-plane
  namespace: default
spec:
  template:
    spec:
      # chalkos has no cloud-init to report back; the providers find out over chalkd.
      virtualMachineBootstrapCheck:
        checkStrategy: none
      virtualMachineTemplate:
        metadata:
          namespace: default
        spec:
          runStrategy: Always
          dataVolumeTemplates:
          - metadata:
              name: system
            spec:
              source:
                registry:
                  url: "docker://@DISK@"
              # At least the containerDisk's virtual size, 7554 MiB.
              storage:
                accessModes: [ReadWriteOnce]
                resources:
                  requests:
                    storage: 20Gi
          template:
            spec:
              domain:
                cpu:
                  cores: 2
                memory:
                  guest: 3Gi
                # chalkos boots with UEFI and seals its disk keys to the TPM, so both keep their
                # state across restarts. KubeVirt's Secure Boot variables hold Microsoft's keys
                # alone, so the unsigned image boots with Secure Boot off.
                firmware:
                  bootloader:
                    efi:
                      secureBoot: false
                      persistent: true
                features:
                  smm:
                    enabled: true
                devices:
                  tpm:
                    persistent: true
                  disks:
                  - name: system
                    disk:
                      bus: virtio
                  # The bridge binding gives the VM its pod's address over DHCP, so the node's
                  # address is the one KubeVirt reports for the Machine.
                  interfaces:
                  - name: default
                    bridge: {}
              networks:
              - name: default
                pod: {}
              volumes:
              - name: system
                dataVolume:
                  name: system
---
apiVersion: infrastructure.cluster.x-k8s.io/v1alpha1
kind: KubevirtMachineTemplate
metadata:
  name: lab-worker
  namespace: default
spec:
  template:
    spec:
      virtualMachineBootstrapCheck:
        checkStrategy: none
      virtualMachineTemplate:
        metadata:
          namespace: default
        spec:
          runStrategy: Always
          dataVolumeTemplates:
          - metadata:
              name: system
            spec:
              source:
                registry:
                  url: "docker://@DISK@"
              storage:
                accessModes: [ReadWriteOnce]
                resources:
                  requests:
                    storage: 20Gi
          template:
            spec:
              domain:
                cpu:
                  cores: 2
                memory:
                  guest: 2Gi
                firmware:
                  bootloader:
                    efi:
                      secureBoot: false
                      persistent: true
                features:
                  smm:
                    enabled: true
                devices:
                  tpm:
                    persistent: true
                  disks:
                  - name: system
                    disk:
                      bus: virtio
                  interfaces:
                  - name: default
                    bridge: {}
              networks:
              - name: default
                pod: {}
              volumes:
              - name: system
                dataVolume:
                  name: system
---
apiVersion: controlplane.cluster.x-k8s.io/v1alpha1
kind: ChalkosControlPlane
metadata:
  name: lab
  namespace: default
spec:
  replicas: 1
  version: "@VERSION@"
  image: "@IMAGE@"
  machineTemplate:
    spec:
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: KubevirtMachineTemplate
        name: lab-control-plane
  # Every node of the cluster gets these documents.
  files:
  # The images of the cluster's components, which containerd pulls as written. The providers set
  # the endpoint and the ranges from the Cluster, and the API server's, controller-manager's,
  # scheduler's and kube-proxy's images from the version.
  - apiVersion: kubernetes.chalkos.dev/v1alpha1
    kind: Cluster
    metadata: {name: default}
    spec:
      images:
        etcd: registry.k8s.io/etcd:3.7.0-0@sha256:6ecefbe2510c4a30573a62a4d6dd175acf881ca67003fcd91849a16df7a724d5
        coredns: registry.k8s.io/coredns/coredns:v1.14.6@sha256:900f9c109f7a33545d3c811516e8376df9019147b750f5ce3e254468769176ea
        pause: registry.k8s.io/pause:3.10.2@sha256:f548e0e8e3dc1896ca956272154dde3314e8cc4fde0a57577ee9fa1c63f5baf4
        flannel: ghcr.io/flannel-io/flannel:v0.28.9@sha256:708a2c9c1cfbfe529d1dbb249cb7113af117f3ed26b5e3e4c8ee015e10555204
  # The VM's one disk, the DataVolume it booted from.
  - apiVersion: storage.chalkos.dev/v1alpha1
    kind: SystemDisk
    metadata: {name: system}
    spec:
      disk: {path: /dev/vda}
  # The VM's one card, on the pod network, which KubeVirt's DHCP server configures.
  - apiVersion: networkd.chalkos.dev/v1alpha1
    kind: Network
    metadata: {name: 10-pod}
    spec:
      match: {name: "en*"}
      network: {dhcp: ipv4}
---
apiVersion: bootstrap.cluster.x-k8s.io/v1alpha1
kind: ChalkosConfigTemplate
metadata:
  name: lab-workers
  namespace: default
spec:
  template:
    spec:
      image: "@IMAGE@"
---
apiVersion: cluster.x-k8s.io/v1beta2
kind: MachineDeployment
metadata:
  name: lab-workers
  namespace: default
spec:
  clusterName: lab
  replicas: 1
  selector:
    matchLabels:
      cluster.x-k8s.io/deployment-name: lab-workers
  template:
    metadata:
      labels:
        cluster.x-k8s.io/deployment-name: lab-workers
    spec:
      clusterName: lab
      version: "@VERSION@"
      bootstrap:
        configRef:
          apiGroup: bootstrap.cluster.x-k8s.io
          kind: ChalkosConfigTemplate
          name: lab-workers
      infrastructureRef:
        apiGroup: infrastructure.cluster.x-k8s.io
        kind: KubevirtMachineTemplate
        name: lab-worker
